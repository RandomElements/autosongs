<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The note. Its stem stops inside the head, so the two read as one
         shape rather than as two things laid on top of each other, and all
         three parts share one light, so the whole note is one object. -->
    <group>
        <!-- the stem -->
        <path android:pathData="M50,27 h8 v39 h-8 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="79"
                    android:endY="81"
                    android:startX="29"
                    android:startY="27"
                    android:type="linear">
                    <item
                        android:color="#FFFFFFFF"
                        android:offset="0" />
                    <item
                        android:color="#FFD9E6FF"
                        android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- the flag -->
        <path android:pathData="M58,27 h21 v9 c-7,1.5 -14,5 -21,9 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="79"
                    android:endY="81"
                    android:startX="29"
                    android:startY="27"
                    android:type="linear">
                    <item
                        android:color="#FFFFFFFF"
                        android:offset="0" />
                    <item
                        android:color="#FFD9E6FF"
                        android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- the head -->
        <path android:pathData="M29,70 a15,11 0 1,0 30,0 a15,11 0 1,0 -30,0 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="79"
                    android:endY="81"
                    android:startX="29"
                    android:startY="27"
                    android:type="linear">
                    <item
                        android:color="#FFFFFFFF"
                        android:offset="0" />
                    <item
                        android:color="#FFD9E6FF"
                        android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
