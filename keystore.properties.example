# The release signing key.
#
# Copy this file to "keystore.properties" and fill it in. That file is
# ignored by git on purpose: it holds the password of the key that signs
# the published app, and anybody who has it could sign an "update" to the
# app and have a phone install it.
#
# The key itself goes in the "keystore/" folder, which is ignored too.
#
# To make one:
#
#   keytool -genkeypair -v -keystore keystore/autosongs-release.jks \
#           -alias autosongs -keyalg RSA -keysize 2048 -validity 10000
#
# Then put its path and passwords in keystore.properties:
#
#   storeFile=keystore/autosongs-release.jks
#   storePassword=<the store password you chose>
#   keyAlias=autosongs
#   keyPassword=<the key password you chose>
#
# Keep the .jks file and these passwords somewhere safe and private, and
# back them up. Without them you cannot ship an update to an app that is
# already installed - Android only accepts an update signed by the same
# key the app was signed with.
#
# Without this file the project still builds: the release build falls back
# to the debug key, which is the same on every machine that has ever
# built an Android app. That is fine for your own testing and wrong for
# anything you publish.

storeFile=keystore/autosongs-release.jks
storePassword=
keyAlias=autosongs
keyPassword=
